# push: node storage through the API server's node proxy
# ---------------------------------------------------------------------------
_STORAGE_PATH_RE = re.compile(r"^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$")   # pod_fs.cpp validate_relative_path


def push_file(args, data, path):
    """PUT `data` to <node storage root>/kube32/<path> on args.node (kubectl replace --raw,
    so kubeconfig credentials apply). Returns (exit code, bytes the node wrote)."""
    if not _STORAGE_PATH_RE.match(path) or len(path) > 96 or any(c in (".", "..") for c in path.split("/")):
        return err_exit("invalid --path '%s' (components of A-Z, a-z, 0-9, '.', '_', '-', no '.' or '..', at most 96 bytes)" % path, EXIT_USAGE), 0
    base = kubectl_base(args)
    if not shutil.which(base[0]):
        return err_exit("%s not found in PATH" % base[0], EXIT_INPUT), 0
    uri = "/api/v1/nodes/%s/proxy/storage/%s" % (args.node, path)
    with tempfile.NamedTemporaryFile(prefix="kube32-push-", delete=False) as f:
        f.write(data)
        tmp = f.name
    try:
        t0 = time.time()
        proc = subprocess.run(base + ["replace", "--raw", uri, "-f", tmp], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        took = time.time() - t0
    finally:
        os.unlink(tmp)
    out = proc.stdout.decode("utf-8", "replace")
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr.decode("utf-8", "replace") or out)
        return err_exit("upload to node %s failed (kubectl exit %d)" % (args.node, proc.returncode), EXIT_KUBECTL), 0
    try:
        written = int(json.loads(out).get("bytes", -1))
    except (ValueError, AttributeError):
        written = -1
    if written != len(data):
        return err_exit("node %s answered %s" % (args.node, out.strip() or "nothing"), EXIT_KUBECTL), 0
    print("pushed %s bytes to %s:kube32/%s in %.1f s" % (fmt_bytes(len(data)), args.node, path, took))
    return EXIT_OK, written


def cmd_push(args):
    if os.path.isdir(args.file):
        return push_dir(args)
    try:
        with open(args.file, "rb") as f:
            data = f.read()
    except OSError as e:
        return err_exit("cannot read %s: %s" % (args.file, e.strerror or e), EXIT_INPUT)
    path = args.path or "images/" + os.path.basename(args.file)
    rc, _ = push_file(args, data, path)
    return rc


def push_dir(args):
    """Upload every regular file below args.file to <--path>/<relative path>, stopping at the first error."""
    root = os.path.normpath(args.file)
    dest = (args.path or "images").strip("/")
    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for name in sorted(filenames):
            full = os.path.join(dirpath, name)
            if os.path.isfile(full) and not os.path.islink(full):
                files.append(full)
    if not files:
        return err_exit("%s contains no files" % args.file, EXIT_INPUT)
    total = 0
    for full in files:
        rel = os.path.relpath(full, root).replace(os.sep, "/")
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError as e:
            return err_exit("cannot read %s: %s" % (full, e.strerror or e), EXIT_INPUT)
        rc, written = push_file(args, data, dest + "/" + rel if dest else rel)
        if rc != EXIT_OK:
            return rc
        total += written
    print("pushed %d files, %s bytes to %s:kube32/%s" % (len(files), fmt_bytes(total), args.node, dest))
    return EXIT_OK


def cmd_sd_push(args):
    try:
        data = read_wasm(args.file)
    except FileNotFoundError as e:
        return err_exit(str(e), EXIT_INPUT)
    name = args.name or os.path.splitext(os.path.basename(args.file))[0]
    if not _SD_TOKEN_RE.match(name) or len(name) > 48:
        return err_exit("invalid image name '%s' (1..48 characters of A-Z, a-z, 0-9, '.', '_', '-', not starting with '.'; pass --name)" % name,
                        EXIT_USAGE)
    if args.tag is not None and (not _SD_TOKEN_RE.match(args.tag) or len(args.tag) > 24):
        return err_exit("invalid tag '%s' (1..24 characters of A-Z, a-z, 0-9, '.', '_', '-', not starting with '.')" % args.tag, EXIT_USAGE)
    if args.to is None and not args.node:
        return err_exit("pass --to <card mount point> for a card in this machine, or --node <node> for the card in a node", EXIT_USAGE)
    if args.to is not None and not os.path.isdir(args.to):
        return err_exit("%s is not a directory: mount the card and pass its mount point, e.g. --to /Volumes/CARD" % args.to, EXIT_INPUT)
    res = check_module(args.file, data)
    if not res.ok:
        print(format_report(res))
        return EXIT_CHECK
    if args.to is None:
        # The card is in a node: over the network
        fname = name + ("-" + args.tag if args.tag else "") + ".wasm"     # sd_image_relative_path()
        rc, _ = push_file(args, data, "images/" + fname)
        if rc == EXIT_OK:
            print("image: wasm://sd/%s%s" % (name, ":" + args.tag if args.tag else ""))
        return rc
    images_dir = os.path.join(args.to, "kube32", "images")
    try:
        os.makedirs(images_dir, exist_ok=True)
    except OSError as e:
        return err_exit("cannot create %s: %s" % (images_dir, e.strerror or e), EXIT_INPUT)
    fname = name + ("-" + args.tag if args.tag else "") + ".wasm"     # sd_image_relative_path()
    dest = os.path.join(images_dir, fname)
    previous = os.path.getsize(dest) if os.path.isfile(dest) else None
    tmp = dest + ".part"
    try:
        with open(tmp, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, dest)
    except OSError as e:
        return err_exit("cannot write %s: %s" % (dest, e.strerror or e), EXIT_INPUT)
    verb = "replaced" if previous is not None else "copied"
    print("%s %s (%s bytes%s)" % (verb, dest, fmt_bytes(len(data)), (", was %s" % fmt_bytes(previous)) if previous is not None else ""))
    print("image: wasm://sd/%s%s" % (name, ":" + args.tag if args.tag else ""))
    if len(data) > SD_IMAGE_LIMIT_PSRAM:
        print("warning: %s bytes is over the 2 MiB the kubelet pulls from a card on any node" % fmt_bytes(len(data)), file=sys.stderr)
    elif len(data) > SD_IMAGE_LIMIT_NO_PSRAM:
        print("warning: %s bytes is over the 256 KiB a node without PSRAM pulls from its card" % fmt_bytes(len(data)), file=sys.stderr)
    return EXIT_OK


# ---------------------------------------------------------------------------
# firmware: stage an image on the control plane and roll it out
# ---------------------------------------------------------------------------
FIRMWARE_PATH = "/apis/kube32.io/v1/firmware"
ROLLOUTS_PATH = "/apis/kube32.io/v1/firmwarerollouts"
ROLLOUT_NAME = "firmware"
ESP_IMAGE_MAGIC = 0xE9
VERSION_MARKER = b"kube32-version:"    # src/api/version_info.cpp


class ApiError(Exception):
    pass


def firmware_image_info(data):
    """(version, sha256 hex) of a firmware file, or raise ValueError: an ESP32
    image whose last 32 bytes are the SHA-256 of the rest, as esptool writes it."""
    if len(data) < 64 or data[0] != ESP_IMAGE_MAGIC:
        raise ValueError("not an ESP32 firmware image (first byte 0x%02x, expected 0xe9)" % (data[0] if data else 0))
    if hashlib.sha256(data[:-32]).digest() != data[-32:]:
        raise ValueError("the image does not end with its own SHA-256 (a truncated or modified file?)")
    version = ""
    at = data.find(VERSION_MARKER)
    if at >= 0:
        end = data.find(b"\0", at, at + len(VERSION_MARKER) + 33)
        if end > 0:
            version = data[at + len(VERSION_MARKER):end].decode("ascii", "replace")
    return version, hashlib.sha256(data).hexdigest()


def api_call(args, verb, path, body=None):
    """kubectl <verb> --raw <path> (kubeconfig credentials apply). Returns the
    parsed JSON answer, None for an empty one; raises ApiError."""
    base = kubectl_base(args)
    if not shutil.which(base[0]):
        raise ApiError("%s not found in PATH" % base[0])
    cmd = base + [verb, "--raw", path]
    tmp = None
    if body is not None:
        with tempfile.NamedTemporaryFile(prefix="kube32-fw-", delete=False) as f:
            f.write(body)
            tmp = f.name
        cmd += ["-f", tmp]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    finally:
        if tmp:
            os.unlink(tmp)
    if proc.returncode != 0:
        msg = (proc.stderr or proc.stdout).decode("utf-8", "replace").strip()
        raise ApiError(msg or "kubectl exit %d" % proc.returncode)
    out = proc.stdout.decode("utf-8", "replace").strip()
    if not out:
        return None
    try:
        return json.loads(out)
    except ValueError:
        raise ApiError("unexpected answer: %s" % out[:200])


def staged_status(args):
    return (api_call(args, "get", FIRMWARE_PATH) or {}).get("status", {})


def short(sha):
    return (sha or "")[:12] or "-"


def cmd_firmware_push(args):
    try:
        with open(args.file, "rb") as f:
            data = f.read()
    except OSError as e:
        return err_exit("cannot read %s: %s" % (args.file, e.strerror or e), EXIT_INPUT)
    try:
        version, sha = firmware_image_info(data)
    except ValueError as e:
        return err_exit("%s: %s" % (args.file, e), EXIT_INPUT)
    try:
        chunk = parse_quantity(args.chunk)
    except ValueError as e:
        return err_exit(str(e), EXIT_USAGE)
    if chunk < 1024:
        return err_exit("--chunk must be at least 1Ki", EXIT_USAGE)
    print("image %s: %s bytes, version %s, sha256 %s" % (args.file, fmt_bytes(len(data)), version or "unknown", sha))
    try:
        st = staged_status(args)
    except ApiError as e:
        return err_exit("cannot read the staged image: %s" % e, EXIT_KUBECTL)
    slot = int(st.get("slotSize", 0))
    if slot and len(data) > slot:
        return err_exit("the image is %s bytes, the control plane's update slot %s" % (fmt_bytes(len(data)), fmt_bytes(slot)), EXIT_INPUT)
    if st.get("phase") == "Staged" and st.get("sha256") == sha:
        print("already staged in %s" % st.get("slot", "?"))
        return EXIT_OK
    offset = 0
    if st.get("phase") == "Receiving" and st.get("sha256") == sha and int(st.get("size", 0)) == len(data):
        offset = int(st.get("received", 0))
        print("resuming at byte %s" % fmt_bytes(offset))
    t0 = time.time()
    sent = 0
    retries = 0
    shown = -1
    while True:
        n = min(chunk, len(data) - offset)
        path = "%s/image?offset=%d&size=%d&sha256=%s" % (FIRMWARE_PATH, offset, len(data), sha)
        try:
            st = (api_call(args, "replace", path, data[offset:offset + n]) or {}).get("status", {})
            retries = 0
        except ApiError as e:
            # The connection broke or the range was refused: continue where
            # the control plane says the upload stands
            retries += 1
            if retries > args.retries:
                return err_exit("upload failed at byte %s: %s" % (fmt_bytes(offset), e), EXIT_KUBECTL)
            print("range at byte %s failed (%s), retrying" % (fmt_bytes(offset), str(e).splitlines()[-1][:120]), file=sys.stderr)
            time.sleep(min(2 * retries, 10))
            try:
                st = staged_status(args)
            except ApiError:
                continue
            if st.get("phase") == "Failed":
                return err_exit("the control plane refused the image: %s" % st.get("message", ""), EXIT_KUBECTL)
            if st.get("phase") == "Receiving" and st.get("sha256") == sha:
                offset = int(st.get("received", 0))
            elif st.get("phase") == "Staged" and st.get("sha256") == sha:
                break
            else:
                offset = 0
            continue
        sent += n
        offset = int(st.get("received", offset + n))
        if st.get("phase") == "Staged":
            break
        if st.get("phase") != "Receiving":
            return err_exit("the control plane answered phase %s: %s" % (st.get("phase"), st.get("message", "")), EXIT_KUBECTL)
        if offset * 10 // len(data) != shown:
            shown = offset * 10 // len(data)
            took = max(time.time() - t0, 0.001)
            print("  %s / %s bytes  %.1f KiB/s" % (fmt_bytes(offset), fmt_bytes(len(data)), sent / 1024.0 / took), flush=True)
    took = max(time.time() - t0, 0.001)
    print("staged %s (%s) in %s on the control plane: %s bytes in %.0f s" %
          (st.get("version") or version or "image", short(sha), st.get("slot", "?"), fmt_bytes(len(data)), took))
    print("next: kube32-cli firmware rollout")
    return EXIT_OK


def get_rollout(args):
    try:
        return api_call(args, "get", "%s/%s" % (ROLLOUTS_PATH, ROLLOUT_NAME))
    except ApiError as e:
        if "NotFound" in str(e) or "not found" in str(e):
            return None
        raise


def node_rows(args):
    nodes = (api_call(args, "get", "/api/v1/nodes") or {}).get("items", [])
    rows = []
    for n in nodes:
        meta = n.get("metadata", {})
        ann = meta.get("annotations", {}) or {}
        labels = meta.get("labels", {}) or {}
        cond = {}
        for c in (n.get("status", {}) or {}).get("conditions", []) or []:
            if c.get("type") == "FirmwareUpdate":
                cond = c
        rows.append({
            "name": meta.get("name", ""),
            "role": "control-plane" if "node-role.kubernetes.io/control-plane" in labels else "worker",
            "version": ann.get("kube32.io/firmware-version", "-"),
            "sha256": ann.get("kube32.io/firmware-sha256", ""),
            "slot": ann.get("kube32.io/firmware-slot", "-"),
            "state": ann.get("kube32.io/firmware-state", "-"),
            "target": ann.get("kube32.io/firmware", ""),
            "failed": ann.get("kube32.io/firmware-failed", ""),
            "update": ("%s: %s" % (cond.get("reason", ""), cond.get("message", ""))) if cond else "-",
        })
    rows.sort(key=lambda r: (r["role"] == "control-plane", r["name"]))
    return rows


def print_table(rows, columns):
    widths = [max(len(title), *(len(str(r[key])) for r in rows)) if rows else len(title) for title, key in columns]
    print("  ".join(title.ljust(w) for (title, _), w in zip(columns, widths)).rstrip())
    for r in rows:
        print("  ".join(str(r[key]).ljust(w) for (_, key), w in zip(columns, widths)).rstrip())


def print_firmware_status(args, staged=True):
    if staged:
        st = staged_status(args)
        line = "staged:  %s" % st.get("phase", "?")
        if st.get("sha256"):
            line += "  %s (%s)  %s/%s bytes  slot %s" % (st.get("version") or "-", short(st.get("sha256")), fmt_bytes(int(st.get("received", 0))),
                                                         fmt_bytes(int(st.get("size", 0))), st.get("slot", "?"))
        if st.get("message"):
            line += "  %s" % st["message"]
        print(line)
    ro = get_rollout(args)
    if ro:
        rs = ro.get("status", {}) or {}
        print("rollout: %s  %s (%s)  %s/%s nodes%s  %s" % (rs.get("phase", "Pending"), rs.get("version") or "-", short(ro.get("spec", {}).get("sha256")),
                                                         rs.get("updatedNodes", 0), rs.get("totalNodes", 0),
                                                         ("  node " + rs["node"]) if rs.get("node") else "", rs.get("message", "")))
    else:
        print("rollout: none")
    rows = node_rows(args)
    for r in rows:
        r["sha256"] = short(r["sha256"])
        r["target"] = short(r["target"])
    print_table(rows, [("NODE", "name"), ("ROLE", "role"), ("VERSION", "version"), ("IMAGE", "sha256"), ("SLOT", "slot"),
                       ("STATE", "state"), ("TARGET", "target"), ("UPDATE", "update")])
    return ro


def cmd_firmware_status(args):
    try:
        print_firmware_status(args)
    except ApiError as e:
        return err_exit(str(e), EXIT_KUBECTL)
    return EXIT_OK


def cmd_firmware_rollout(args):
    try:
        st = staged_status(args)
        if st.get("phase") != "Staged":
            return err_exit("no image is staged (phase %s): kube32-cli firmware push <firmware.bin> first" % st.get("phase", "?"), EXIT_INPUT)
        sha = st["sha256"]
        if args.sha256 and args.sha256.lower() != sha:
            return err_exit("the staged image is %s, not %s" % (sha, args.sha256), EXIT_INPUT)
        ro = get_rollout(args)
        if ro:
            phase = (ro.get("status") or {}).get("phase", "")
            if phase not in ("Complete", "Failed"):
                return err_exit("rollout %s is in progress (kube32-cli firmware status; kube32-cli firmware abort stops it)" % ROLLOUT_NAME,
                                EXIT_EXISTS)
            api_call(args, "delete", "%s/%s" % (ROLLOUTS_PATH, ROLLOUT_NAME))
        spec = {"sha256": sha}
        if args.node_timeout:
            spec["nodeTimeoutSeconds"] = args.node_timeout
        manifest = {"apiVersion": "kube32.io/v1", "kind": "FirmwareRollout", "metadata": {"name": ROLLOUT_NAME}, "spec": spec}
        api_call(args, "create", ROLLOUTS_PATH, json.dumps(manifest).encode())
    except ApiError as e:
        return err_exit(str(e), EXIT_KUBECTL)
    print("rolling out %s (%s): workers one at a time, then the control plane" % (st.get("version") or "image", short(sha)))
    if args.no_wait:
        print("follow it with: kube32-cli firmware status, kubectl get firmwarerollouts, kubectl get events")
        return EXIT_OK
    # The control plane restarts last: the API is away for a while then
    last = None
    deadline = time.time() + args.timeout
    while time.time() < deadline:
        time.sleep(args.interval)
        try:
            ro = get_rollout(args)
        except ApiError:
            if last != "unreachable":
                print("  the API server does not answer (the control plane restarts into the image?), waiting")
                last = "unreachable"
            continue
        rs = (ro or {}).get("status", {}) or {}
        phase = rs.get("phase", "Pending")
        line = "  %s %s/%s nodes  %s" % (phase, rs.get("updatedNodes", 0), rs.get("totalNodes", 0), rs.get("message", ""))
        if line != last:
            print(line, flush=True)
            last = line
        if not ro:
            return err_exit("the rollout was deleted", EXIT_KUBECTL)
        if phase == "Complete":
            try:
                print_firmware_status(args, staged=False)
            except ApiError:
                pass
            return EXIT_OK
        if phase == "Failed":
            return err_exit("rollout failed: %s" % rs.get("message", ""), EXIT_ROLLOUT)
    return err_exit("the rollout did not finish within %d s (kube32-cli firmware status)" % args.timeout, EXIT_ROLLOUT)


def cmd_firmware_abort(args):
    try:
        if not get_rollout(args):
            print("no rollout")
            return EXIT_OK
        api_call(args, "delete", "%s/%s" % (ROLLOUTS_PATH, ROLLOUT_NAME))
    except ApiError as e:
        return err_exit(str(e), EXIT_KUBECTL)
    print("rollout deleted: nodes that have not switched yet keep their firmware")
    return EXIT_OK


def cmd_firmware_info(args):
    try:
        with open(args.file, "rb") as f:
            data = f.read()
        version, sha = firmware_image_info(data)
    except OSError as e:
        return err_exit("cannot read %s: %s" % (args.file, e.strerror or e), EXIT_INPUT)
    except ValueError as e:
        return err_exit("%s: %s" % (args.file, e), EXIT_INPUT)
    print("version: %s\nsha256:  %s\nsize:    %s bytes" % (version or "unknown", sha, fmt_bytes(len(data))))
    return EXIT_OK


