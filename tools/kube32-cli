#!/usr/bin/env python3
"""kube32-cli from a source checkout: runs the kube32 package in python/src.

Installed with `uv tool install kube32`, the same commands are `kube32` (and
`kube32-cli`). See docs/cli-reference.md.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "python", "src"))

from kube32.cli import main_cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(main_cli())
