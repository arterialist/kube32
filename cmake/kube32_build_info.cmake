# Writes the build identity served by GET /version: the git commit and tree
# state of SOURCE_DIR, the UTC time this script ran and the firmware version
# nodes report. Called from the host
# build (CMakeLists.txt) and the firmware component (src/CMakeLists.txt)
# whenever a source file or the git checkout changes.
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P kube32_build_info.cmake

set(commit "")
set(tree_state "")
find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} rev-parse HEAD
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0)
        set(commit "")
    else()
        execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} status --porcelain --untracked-files=no
                        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE
                        RESULT_VARIABLE rc ERROR_QUIET)
        if(rc EQUAL 0)
            if(changes STREQUAL "")
                set(tree_state "clean")
            else()
                set(tree_state "dirty")
            endif()
        endif()
    endif()
endif()
string(TIMESTAMP build_date "%Y-%m-%dT%H:%M:%SZ" UTC)

# The firmware version nodes report: $KUBE32_VERSION, or `git describe`
set(version "$ENV{KUBE32_VERSION}")
if(version STREQUAL "" AND GIT_EXECUTABLE)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} describe --tags --always --dirty
                    OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0)
        set(version "")
    endif()
endif()
string(REGEX REPLACE "[^A-Za-z0-9._+-]" "" version "${version}")
string(SUBSTRING "${version}" 0 31 version)
if(version STREQUAL "")
    set(version "unknown")
endif()

file(WRITE ${OUTPUT}.tmp
"// Generated by cmake/kube32_build_info.cmake. Do not edit.
#pragma once
#define KUBE32_GIT_COMMIT \"${commit}\"
#define KUBE32_GIT_TREE_STATE \"${tree_state}\"
#define KUBE32_BUILD_DATE \"${build_date}\"
#define KUBE32_FIRMWARE_VERSION \"${version}\"
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp ${OUTPUT})
file(REMOVE ${OUTPUT}.tmp)
