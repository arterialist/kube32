# ESP32-S31 kit (ESP-Mosaico): 16 MB quad SPI flash, in-package octal PSRAM, 320 MHz dual core
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=320
# newlib: the C library this firmware has run with on every board so far
CONFIG_LIBC_NEWLIB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-kit.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-kit.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BSP_DISPLAY_ENABLE=y
# CONFIG_BSP_DISPLAY_LVGL_ENABLE is not set

# The kit's Type-C port is USB OTG: the console runs over CDC-ACM
CONFIG_KUBE32_CONSOLE_USB_OTG=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Kube32 Console"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Kube32"
CONFIG_TINYUSB_DESC_CDC_STRING="Kube32 Console"
